# Your actual inventory: the rooms of your home and what's in your drawers.
# That is personal data, not code, and on a public repo anyone could read it.
data/
*.json.tmp

# Python bytecode and virtual environments. Rebuildable, machine-specific.
__pycache__/
*.py[cod]
.venv/
venv/
env/

# PyInstaller output. Rebuildable, and often hundreds of megabytes.
build/
dist/
release/

# Invenfloor.spec is NOT ignored, and that is deliberate. It used to be, back
# when the spec was whatever PyInstaller generated on somebody's machine. It
# is now the build recipe: build.bat and the GitHub Actions workflow both run
# it, which is what makes a build here and a build on GitHub the same build.

# Editor and OS clutter.
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Delivered zips and exports, not source.
Claude outputs/
*.zip
